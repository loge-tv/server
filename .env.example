# Copy to .env next to compose.yaml and fill in.

# Your Plex server, by its address in your home network (127.0.0.1 would be the
# container itself).
PLEX_URL=http://192.168.1.10:32400

# The token of the Plex account that owns the server (README: "Plex token").
PLEX_TOKEN=

# The folder with your movies and shows on this machine.
MEDIA_DIR=/srv/media

# Only when Plex runs in Docker and shows the files under another path than
# MEDIA_DIR (Plex: a file, Get Info, its path): that path for the same folder.
#MEDIA_PATH_IN_PLEX=/media

# Optional: your own TMDB API key, see the configuration table in README.
#TMDB_API_KEY=
